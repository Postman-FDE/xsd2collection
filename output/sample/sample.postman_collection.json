{
  "info": {
    "name": "sample",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "BasicDocument",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const xmlBody = pm.request.body.toString();",
              "",
              "const validationResult = await new Promise((resolve, reject) => {",
              "  pm.sendRequest({",
              "    url: pm.variables.replaceIn('{{validationUrl}}') + '/sample/BasicDocument',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/xml'",
              "    },",
              "    body: {",
              "      mode: 'raw',",
              "      raw: xmlBody",
              "    }",
              "  }, function (err, response) {",
              "    if (err) {",
              "      reject(err);",
              "      return;",
              "    }",
              "    resolve(response.json());",
              "  });",
              "});",
              "",
              "console.log('Validation result:', JSON.stringify(validationResult, null, 2));",
              "",
              "if (!validationResult.valid) {",
              "  console.error('[FAIL] XSD Validation failed: ' + validationResult.message);",
              "  throw new Error('XSD Validation failed: ' + validationResult.message);",
              "} else {",
              "  console.log('[OK] XSD validation passed, proceeding with request...');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/xml"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<BasicDocument xmlns=\"http://example.com/xsd2collection/sample\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">\n  <Id>DOC-1001</Id>\n  <Message>SAMPLE_TEXT</Message>\n  <CreatedAt>2024-01-01T00:00:00</CreatedAt>\n</BasicDocument>",
          "options": {
            "raw": {
              "language": "xml"
            }
          }
        },
        "url": {
          "raw": "{{baseurl}}/sample/BasicDocument",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "sample",
            "BasicDocument"
          ]
        }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<BasicDocument xmlns=\"http://example.com/xsd2collection/sample\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\">\n  <Id>DOC-1001</Id>\n  <Message>SAMPLE_TEXT</Message>\n  <CreatedAt>2024-01-01T00:00:00</CreatedAt>\n</BasicDocument>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/sample/BasicDocument",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "sample",
                "BasicDocument"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "xml",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/xml"
            }
          ],
          "cookie": []
        }
      ]
    }
  ]
}